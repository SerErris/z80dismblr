{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": [
                "$tsc-watch"
            ],
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "build-docs",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Executables",
            "type": "shell",
            "command": "zsh",
            "args": [
                "-c",
                "rm *.zip; pkg -t node13-macos,node13-linux,node13-win out/z80map.js && zip z80map-linux.zip z80map-linux && zip z80map-macos.zip z80map-macos && zip z80map-win.zip z80map-win.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "z80check",
            "type": "shell",
            "command": "sjasmplus",
            "args": [
                "--nologo",
                "--msg=all",
                "--fullpath",
                "--raw=/dev/null",
                "${file}"
            ],
            "problemMatcher": "$errmatcher-sjasmplus",
            "presentation": {
                "reveal": "silent", // Verhindert das Aufpoppen des Terminals
                "panel": "shared",
                "clear": true,
                "focus": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}